# --- Público (se hornea en el bundle del cliente) ---
NEXT_PUBLIC_SITE_URL=https://fidelmercadotech.com
NEXT_PUBLIC_SITE_NAME="Fidel Mercado Tech"
NEXT_PUBLIC_WHATSAPP_NUMBER=573058148918
NEXT_PUBLIC_CONTACT_PHONE="+57 305 814 8918"
NEXT_PUBLIC_CONTACT_EMAIL=contacto@fidelmercadotech.com

# --- Formulario de contacto ---
# PHP en Hostinger que recibe el JSON del wizard y envía correo a contacto@fidelmercadotech.com.
# El sitio es estático: esta variable se incrusta al compilar (por eso lleva NEXT_PUBLIC_).
# Si queda vacía en producción, el formulario termina en WhatsApp con el mensaje ya redactado.
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=https://fidelmercadotech.com/api/contact.php

