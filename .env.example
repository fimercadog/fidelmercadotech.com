# --- Público (se hornea en el bundle del cliente) ---
NEXT_PUBLIC_SITE_URL=https://fidelmercadotech.com
NEXT_PUBLIC_SITE_NAME="Fidel Mercado Tech"
NEXT_PUBLIC_WHATSAPP_NUMBER=573027029498
NEXT_PUBLIC_CONTACT_PHONE="+57 302 702 9498"
NEXT_PUBLIC_CONTACT_EMAIL=contacto@fidelmercadotech.com

# --- Formulario de contacto ---
# Webhook de n8n que recibe los contactos del formulario (guía: docs/n8n-formulario-contacto.md).
# El sitio es estático: esta variable se incrusta al compilar (por eso lleva NEXT_PUBLIC_).
# Si queda vacía en producción, el formulario termina en WhatsApp con el mensaje ya redactado (no se guarda en hoja ni correo).
NEXT_PUBLIC_CONTACT_WEBHOOK_URL=

